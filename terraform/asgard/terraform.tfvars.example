# Non-sensitive config only — copy to terraform.tfvars and adjust if needed.
# Secrets (proxmox_api_token) live in secrets.enc.yaml — edit with:
#   sops terraform/asgard/secrets.enc.yaml
proxmox_endpoint = "https://<PROXMOX_IP>:8006"
proxmox_node     = "yggdrasil"
datastore_id     = "local-zfs"
iso_file_id      = "local:iso/OPNsense-<VERSION>-dvd-amd64.iso"
